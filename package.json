{
  "name": "pequidev",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "worker": "pnpm --filter @pequidev/workers run cli",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@pequidev/config": "workspace:*",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}
